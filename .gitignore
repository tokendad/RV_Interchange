# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log
/logs/

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Python
__pycache__/
*.pyc

# Isolated implementation worktrees
.worktrees/

# Subagent-driven-development scratch (ledgers, briefs, review packages)
.superpowers/

# Raw web-archive page captures (evidence lives in observations.db, not git —
# see Docs/Data/PARKED-myrvworks_manual_library.md convention: sources get
# hand-transcribed into observations.db, not committed as raw fetched files)
Docs/Data/**/https___*.html
Docs/Data/**/https___*_files/

# Oversized source PDFs (exceed GitHub's 100MB limit) — kept on disk, not in git
Docs/Data/Atwood/ParkPower Catalog.pdf

# Personal in-hand RV photos/build sheet — never commit, identifies the owner's specific
# coach; evidence gets hand-transcribed into observations.db instead
Docs/Data/Current RV - DO NOT COMMIT THIS FOLDER/

# Resolver output db — rebuildable from observations.db, not source of truth
Docs/Tools/components.db

# Claude Code project instructions — local only, not shared via git
CLAUDE.md
.claude/

# Images — going forward, evidence photos get hand-transcribed into observations.db
# instead of committed as binary files. Already-tracked images as of 2026-08-06 are
# unaffected (git keeps tracking files added before a gitignore rule existed).
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.webp
*.heic

# Public brand assets are application resources, not evidence photos.
!web/assets/
!web/assets/*.png
